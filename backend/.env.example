# Chép file này thành file .env (cùng thư mục backend) rồi điền các dòng còn trống.
# File .env chứa mật khẩu nên KHÔNG BAO GIỜ đưa lên GitHub (file .gitignore đã chặn sẵn).
# Giá trị có dấu # hoặc khoảng trắng thì đặt trong ngoặc kép, ví dụ DB_PASSWORD="abc#123"
# (không có ngoặc kép thì phần từ dấu # trở đi bị bỏ mất).

# ===== Máy chủ =====
NODE_ENV=development
PORT=8000
# Địa chỉ frontend, không có dấu / ở cuối.
# Muốn thử bằng điện thoại cùng wifi thì đổi thành địa chỉ wifi của máy tính, ví dụ http://192.168.1.5:5173
CLIENT_ORIGIN=http://localhost:5173
# Để trống là tắt. Chỉ điền khi đưa web lên máy chủ thật có máy trung gian khác đứng trước
# (ghi địa chỉ IP của máy trung gian đó, nhiều địa chỉ thì cách nhau bằng dấu phẩy).
TIN_MAY_TRUNG_GIAN=

# ===== MySQL (Laragon mặc định: tài khoản root, mật khẩu trống, cổng 3306) =====
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ava
DB_USER=root
DB_PASSWORD=

# ===== Khóa ký phiên đăng nhập và khóa ký cookie (bí mật) =====
# Tự gõ hai chuỗi ngẫu nhiên KHÁC NHAU, mỗi chuỗi dài ít nhất 16 ký tự, chỉ dùng chữ không dấu và số.
# Để trống thì máy chủ báo lỗi và không chạy.
JWT_SECRET=
COOKIE_SECRET=

# ===== VNPay sandbox (điền khi làm Phần 13, lấy trong email VNPay gửi khi đăng ký sandbox) =====
VNP_TMN_CODE=
VNP_HASH_SECRET=
VNP_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNP_API_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction

# ===== Gmail gửi mã của website (điền khi làm Phần 3, Phần 4; dùng mật khẩu ứng dụng của Google) =====
GMAIL_USER=
GMAIL_APP_PASSWORD=

# ===== Tài khoản admin tạo bằng lệnh npm run seed =====
# Tên đăng nhập: chữ không dấu và số, 4 đến 30 ký tự. Gmail: có đuôi @gmail.com. Mật khẩu: đúng 6 chữ số.
ADMIN_TEN_DANG_NHAP=
ADMIN_GMAIL=
ADMIN_MAT_KHAU=
